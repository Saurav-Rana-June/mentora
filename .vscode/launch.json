{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Mentora App (Mobile)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=FLAVOR=app"
            ]
        },
        {
            "name": "Mentora CMS (Web - Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "-d",
                "chrome",
                "--dart-define=FLAVOR=cms"
            ]
        },
        {
            "name": "Mentora CMS (General)",
            "request": "launch",
            "type": "dart",
            "args": [
                "--dart-define=FLAVOR=cms"
            ]
        },
        {
            "name": "Mentora App (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": [
                "--dart-define=FLAVOR=app"
            ]
        },
        {
            "name": "Mentora App (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--dart-define=FLAVOR=app"
            ]
        }
    ]
}